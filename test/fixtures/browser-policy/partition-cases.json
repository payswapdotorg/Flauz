{
	"$comment": "Partition-name fixtures (L4 isolation model): derivation inputs, valid/invalid name shapes, and containment expectations. Name shape: persist:flauz-<16 lowercase hex>[-<agent-id>] or the memory-scope form without the persist: prefix; agent ids match [A-Za-z0-9._-]{1,64}.",
	"derivations": [
		{
			"workspaceRoot": "/home/dev/acme",
			"agentId": null,
			"rules": { "scope": "persist", "perAgent": false },
			"expectShape": "persist:flauz-<hash>"
