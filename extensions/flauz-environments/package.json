{
	"name": "flauz-environments",
	"displayName": "Flauz Environments",
	"description": "Flauz environment registry: typed env descriptors (.flauz/environments.json), provider adapters for SSH/container/cloud-sandbox/workspace-remote, connection-plan generation, and the env-switch session-continuity model (Wave 4 Lane J).",
	"version": "0.1.0",
	"publisher": "flauz",
	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onView:flauz.environments",
		"onCommand:flauz.env.list",
		"onCommand:flauz.env.register",
		"onCommand:flauz.env.unregister",
		"onCommand:flauz.env.activate",
		"onCommand:flauz.env.deactivate",
		"onCommand:flauz.env.showPlan",
		"onCommand:flauz.env.switch",
		"onCommand:flauz.focusView.environments",
		"onCommand:flauz.env.refreshView"
	],
	"main": "./dist/extension.js",
	"enabledApiProposals": [],
	"contributes": {
		"views": {
			"flauz": [
				{
					"id": "flauz.environments",
					"name": "Environments"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "flauz.environments",
				"contents": "No Flauz environments registered.\nEnvironments (local, SSH, container, cloud sandbox) live in .flauz/environments.json and carry trust, capabilities and connection plans.\n[Refresh Environments View](command:flauz.env.refreshView)\n[Back to Flauz Home](command:flauz.focusView.home)"
			}
		],
		"commands": [
			{
				"command": "flauz.env.list",
				"title": "List Environments",
				"category": "Flauz"
			},
			{
				"command": "flauz.env.register",
				"title": "Register Environment",
				"category": "Flauz"
			},
			{
				"command": "flauz.env.unregister",
				"title": "Unregister Environment",
				"category": "Flauz"
			},
			{
				"command": "flauz.env.activate",
				"title": "Activate Environment",
				"category": "Flauz"
			},
			{
				"command": "flauz.env.deactivate",
				"title": "Deactivate Environment",
				"category": "Flauz"
			},
			{
				"command": "flauz.env.showPlan",
				"title": "Show Connection Plan",
				"category": "Flauz"
			},
			{
				"command": "flauz.env.switch",
				"title": "Switch Environment (Re-open Continuity)",
				"category": "Flauz"
			},
			{
				"command": "flauz.focusView.environments",
				"title": "Focus Flauz Environments",
				"category": "Flauz"
			},
			{
				"command": "flauz.env.refreshView",
				"title": "Refresh Environments View",
				"category": "Flauz",
				"icon": "$(refresh)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "flauz.env.refreshView",
					"when": "view == flauz.environments",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/*.test.ts\""
	},
	"devDependencies": {
		"typescript": "5.9.3"
	}
}
