{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": []
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"shims/**/*.d.ts",
		"core/contracts.d.mts",
		"core/a2a.d.mts",
		"core/protocol.d.mts",
		"core/orchestration.d.mts",
		"core/policy.d.mts",
		"core/orchStore.d.mts",
		"core/recovery.d.mts",
		"core/runtime.d.mts",
		"vscode-dts/vscode.d.ts"
	]
}
