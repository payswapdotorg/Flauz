{
	"name": "flauz-browser",
	"publisher": "flauz",
	"displayName": "Flauz Browser Policy & Runtime",
	"description": "Flauz layered browser navigation policy engine (driver-side allowlist + webRequest + will-navigate + per-workspace/agent partitions) with .flauz/browser-policy.json as the per-workspace policy source, plus the Flauz-controlled Chromium/CDP browser runtime (sessions, policy-gated navigation, capture, recovery).",
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": {
		"vscode": "^1.140.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:flauz.browser.setPolicy",
		"onCommand:flauz.browser.showPolicy",
		"onCommand:flauz.browser.verifyPolicy",
		"onCommand:flauz.browser.checkUrl",
		"onCommand:flauz.browser.evaluate",
		"onCommand:flauz.browser.openSession",
		"onCommand:flauz.browser.closeSession",
		"onCommand:flauz.browser.sessions",
		"onCommand:flauz.browser.navigate",
		"onCommand:flauz.browser.screenshot"
	],
	"main": "./dist/extension.js",
	"enabledApiProposals": [
		"browser"
	],
	"contributes": {
		"commands": [
			{
				"command": "flauz.browser.setPolicy",
				"title": "Open (or Create) Browser Policy File",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.showPolicy",
				"title": "Show Effective Browser Policy",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.verifyPolicy",
				"title": "Verify Browser Policy File",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.checkUrl",
				"title": "Check a URL Against the Browser Policy",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.evaluate",
				"title": "Evaluate a Navigation Against the Browser Policy",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.openSession",
				"title": "Open a Flauz Browser Session",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.closeSession",
				"title": "Close a Flauz Browser Session",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.sessions",
				"title": "List Flauz Browser Sessions",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.navigate",
				"title": "Navigate a Flauz Browser Tab (Policy-Gated)",
				"category": "Flauz"
			},
			{
				"command": "flauz.browser.screenshot",
				"title": "Capture a Flauz Browser Tab Screenshot",
				"category": "Flauz"
			}
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/*.test.ts\""
	},
	"devDependencies": {
		"typescript": "^5.9.0"
	}
}
