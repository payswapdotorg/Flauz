{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"useUnknownInCatchVariables": false,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types": []
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"shims/**/*.d.ts",
		"test/**/*.ts",
		"vscode-dts/vscode.d.ts"
	],
	"exclude": [
		"test/session-battery.test.ts",
		"test/canaries/session-battery-runtime.drill.ts",
		"test/agentos-battery.test.ts",
		"test/canaries/agentos-runtime.drill.ts"
	]
}
