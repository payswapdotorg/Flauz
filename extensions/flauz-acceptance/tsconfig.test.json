{
	// The full program (src + the suite), the W1 sibling's posture verbatim:
	// the two lint-shaped flags are relaxed HERE ONLY so sibling-consumed
	// shapes never fail this wave's program; tsconfig.json (the src-only
	// program, the scoped tsc) keeps them on for every file this wave owns.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"forceConsistentCasingInFileNames": true,
		"useUnknownInCatchVariables": false,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"noEmit": true,
		"types": []
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.d.ts",
		"shims/**/*.d.ts",
		"test/**/*.ts",
		"vscode-dts/vscode.d.ts"
	]
}
