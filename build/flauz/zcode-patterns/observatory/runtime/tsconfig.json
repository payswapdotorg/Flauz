{
        "compilerOptions": {
                "target": "es2022",
                "module": "nodenext",
                "moduleResolution": "nodenext",
                "lib": ["es2022"],
                "types": ["node", "mocha"],
                "strict": true,
                "noEmit": true,
                "allowImportingTsExtensions": true,
                "skipLibCheck": true,
                "forceConsistentCasingInFileNames": true
        },
        "include": ["observatory.ts", "observatory.test.ts"]
}
